# Copy to .env and fill in. Never commit .env.

# Data
DATA_DIR=data/raw

# MLflow (local SQLite store by default)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT=fraudshield

# Kaggle CLI reads ~/.kaggle/kaggle.json, or these:
KAGGLE_USERNAME=
KAGGLE_KEY=

# Later weeks
# DATABASE_URL=postgresql://fraud:fraud@localhost:5432/fraudshield
# REDIS_URL=redis://localhost:6379/0
# KAFKA_BOOTSTRAP=localhost:9092
